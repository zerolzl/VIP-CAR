# VIP专用车位告警系统 - 环境变量配置示例
# 复制此文件为 .env 并修改对应值

# MySQL数据库配置
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=vip_parking

# 安全密钥（用于密码加密，至少32字符）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-very-strong-secret-key-at-least-32-chars

# 巡检间隔（秒）
PATROL_INTERVAL_SECONDS=30

# 应用配置
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
